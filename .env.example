# USInv Environment Variables Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (Windows PowerShell)

# ==============================================================================
# 1. Alpaca Broker & Market Data (Paper / Live)
# ==============================================================================
# Used by: usinv/broker/alpaca.py, usinv/data/prices/alpaca.py, ai/
# Get your free paper trading keys at: https://alpaca.markets
ALPACA_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Optional Alpaca SDK standard aliases (automatically supported as fallbacks):
# APCA_API_KEY_ID=your_alpaca_key_id_here
# APCA_API_SECRET_KEY=your_alpaca_secret_key_here
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ==============================================================================
# 2. SEC EDGAR API Requirements
# ==============================================================================
# Mandatory for SEC EDGAR requests (SEC Fair Access policy requires User-Agent
# in format: "Sample Company Name AdminContact@<sample company domain>.com")
# Used by: usinv/data/edgar/client.py, usinv/data/edgar/bulk.py
USINV_EDGAR_EMAIL=your_monitored_email@domain.com

# ==============================================================================
# 3. Alpha Vantage (Historical Listings & Delistings)
# ==============================================================================
# Used by: usinv/data/listings.py for LISTING_STATUS snapshots
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# ==============================================================================
# 4. Tiingo (Price History & Cross-Source Reconciliation)
# ==============================================================================
# Used by: usinv/data/prices/tiingo.py for price spot-checks & ticker lifecycle
# Get a free token at: https://www.tiingo.com
TIINGO_TOKEN=your_tiingo_token_here

# ==============================================================================
# 5. FRED / ALFRED (Macroeconomic & Credit Regimes)
# ==============================================================================
# Used by: usinv/regime/macro.py for NFCI, Sahm Rule, HY OAS spreads
# Get a free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ==============================================================================
# 6. Telegram Notifications (Production Delivery & Alerts)
# ==============================================================================
# Used by: usinv/delivery/telegram.py for daily rotation signals and fill notifications
# Create a bot via @BotFather and retrieve chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
